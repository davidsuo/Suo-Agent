#!/bin/bash
# AI Native 开发契约 · pre-commit hook v2
# 作用：提交前语法/编译/类型检查 + 耗时统计

set -e
START_TS=$(date +%s)

echo "🔍 [pre-commit] 运行语法检查..."

# 1. Python 语法 + 编译检查
PY_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)
if [ -n "$PY_FILES" ]; then
    for f in $PY_FILES; do
        python -c "import ast; ast.parse(open('$f', encoding='utf-8').read())" || {
            echo "❌ Python 语法错误: $f"; exit 1;
        }
        python -m py_compile "$f" || {
            echo "❌ Python 编译错误: $f"; exit 1;
        }
    done
    echo "✅ Python 语法/编译检查通过"
else
    echo "⏭️  无 Python 文件改动，跳过"
fi

# 2. TypeScript 类型检查
TS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.tsx?$' || true)
if [ -n "$TS_FILES" ]; then
    echo "🔍 [pre-commit] 检测到 TS 改动，运行 tsc..."
    (cd frontend && npx tsc --noEmit) || {
        echo "❌ TypeScript 类型错误"; exit 1;
    }
    echo "✅ TypeScript 类型检查通过"
fi

END_TS=$(date +%s)
echo "🎉 [pre-commit] 全部检查通过（耗时 $((END_TS - START_TS))s）"